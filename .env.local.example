# Salin file ini menjadi .env.local lalu isi nilainya.
# Nilai diambil dari Supabase Dashboard > Project Settings > API Keys / Data API.

# URL proyek Supabase, mis. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) atau legacy anon key. Aman untuk browser,
# karena akses dibatasi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) atau legacy service_role key.
# RAHASIA: hanya dipakai di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publik website (untuk metadata, sitemap, Open Graph).
# Lokal: http://localhost:3000 — produksi: domain Vercel atau domain sendiri.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
